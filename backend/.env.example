PORT=4100
NODE_ENV=development
# 로컬 개발 전용: 무인증 /dev/token 발급을 켠다. 운영에서는 절대 설정하지 말 것.
# 이 값이 true가 아니면 서버는 실제 JWT_SECRET·MEDUSA_WEBHOOK_SECRET를 요구하며 없으면 기동을 중단한다.
ALLOW_DEV_TOKEN=true
DATABASE_URL=postgres://earthplayground:change-me@localhost:5432/earthplayground
JWT_SECRET=replace-with-at-least-32-random-characters
MEDUSA_WEBHOOK_SECRET=replace-with-medusa-webhook-secret
OUTBOX_TARGET_URL=http://localhost:9000/hooks/earthplayground
OUTBOX_TOKEN=replace-with-service-token
# 상품·쇼케이스 이미지 로컬 저장 위치(임시). 정식 배포 시 서버 스토리지로 교체.
ASSET_STORAGE_DIR=./uploads
